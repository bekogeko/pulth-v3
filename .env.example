# Copy to .env.local and fill in. Validated at startup by lib/env.ts (t3-env).
# Set SKIP_ENV_VALIDATION=1 to bypass (e.g. in CI lint jobs).

# Postgres connection string (required)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Max connections in the pg pool (optional, defaults to 1)
# DATABASE_POOL_MAX=1

# Clerk (required)
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# PostHog (token required, hosts optional)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_API_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Canonical site URL (optional, falls back to Vercel URLs / localhost)
# NEXT_PUBLIC_SITE_URL=https://example.com
